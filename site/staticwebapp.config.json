{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    { "route": "/login", "redirect": "/login.html" },
    { "route": "/logout", "redirect": "/.auth/logout" },
    { "route": "/login.html", "allowedRoles": ["anonymous"] },
    { "route": "/unauthorized.html", "allowedRoles": ["anonymous"] },
    { "route": "/*", "allowedRoles": ["viewer"] }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/login.html",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/unauthorized.html",
      "statusCode": 403
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{css,js,svg,png,jpg,jpeg,gif,ico}"]
  }
}
